# Copie este arquivo para .env e preencha com os valores reais.
# Variáveis do Vite precisam começar com VITE_ pra ficarem visíveis no
# código do navegador (import.meta.env.VITE_...).

# Client ID do OAuth do Google (Google Cloud Console > Credenciais). Mesmo
# valor usado no backend (GOOGLE_CLIENT_ID) — não é segredo.
VITE_GOOGLE_CLIENT_ID=

# URL do backend. Sem isso definido, o app cai em http://localhost:3333
# (bom pra dev local). Em produção e homologação no Vercel, configure esta
# variável nas Environment Variables do projeto (uma por ambiente):
#   Production  -> https://noteplusbackend.onrender.com
#   Preview/dev -> https://homologacaonoteplusbackend.onrender.com
VITE_API_URL=
